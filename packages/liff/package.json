{
    "name": "@linekit/liff",
    "version": "0.0.1",
    "description": "LINE LIFF (LINE Front-end Framework) SDK - Coming Soon",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run"
    },
    "keywords": [
        "line",
        "liff",
        "sdk",
        "frontend"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^2.1.0"
    }
}
